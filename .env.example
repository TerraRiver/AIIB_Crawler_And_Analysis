# 要抓取的数据模块，逗号分隔: projects,procurement,governance,accountability 或 all（留空则启动时交互询问）
CRAWL_TYPES=

# 断点处理模式: resume（继续上次进度）或 reset（备份旧数据并重新开始），留空则发现旧数据时交互询问
RESUME_MODE=

# 重点过滤国家（默认 ALL 抓取全行所有成员国数据作为对照基准；可设为 India 仅抓取印度项目详情页）
COUNTRY_FILTER=ALL

# 是否下载 PDF 原始文件（none: 仅抓取元数据与Excel, india: 仅下载印度相关核心PDF, all: 下载全部PDF）
DOWNLOAD_PDFS=india

# 最大抓取的项目详情页数量（0 表示不限制，全量抓取）
MAX_DETAIL_PAGES=0

# 时间过滤范围（可选），支持 YYYY 或 YYYY-MM-DD
SINCE=
UNTIL=

# 解析无时区时间以及日志展示使用的时区（默认 UTC，支持 +08:00 或 Asia/Shanghai 等 IANA 时区名）
TIMEZONE=UTC

# 是否使用无头浏览器模式 (true / false)
HEADLESS=true

# 数据存储目录（默认 ./data）
DATA_DIR=./data

# 浏览器持久化配置目录（默认 ./data/browser_profile）
BROWSER_PROFILE_DIR=
